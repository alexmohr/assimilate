  "query": "SELECT r.name, COALESCE(rs.compressed_size, 0)::INT8 AS \"compressed_size!\", COALESCE(rs.deduplicated_size, 0)::INT8 AS \"deduplicated_size!\" FROM repos r LEFT JOIN repo_stats rs ON rs.repo_id = r.id WHERE ($1::BIGINT[] IS NULL OR r.id = ANY($1)) ORDER BY rs.deduplicated_size DESC NULLS LAST",
