  "query": "SELECT r.id, r.name, r.repo_path, r.ssh_user, h.ssh_host, h.ssh_port, r.compression AS \"compression: Compression\", r.encryption AS \"encryption: BorgEncryption\", r.enabled, r.owner_id, r.visibility AS \"visibility: Visibility\", r.sync_schedule, r.repo_host_id, h.wake_enabled, h.wake_mac_address, h.wake_broadcast_address, h.wake_timeout_seconds, h.shutdown_after_backup FROM repos r JOIN repo_hosts h ON h.id = r.repo_host_id ORDER BY r.name",
