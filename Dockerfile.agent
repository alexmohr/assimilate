# Stage 1: Build Rust agent binary
# Release binaries are built with a pinned stable compiler, not nightly, so a
# shipped artifact never depends on an unstable toolchain. Keep this in sync
# with the other stable pins (search the repo for "rust:1.98" / "1.98").
FROM rust:1.98-trixie AS rust-builder
ARG AGENT_VERSION
ENV APP_VERSION_OVERRIDE=$AGENT_VERSION
WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
RUN cargo build --release --locked -p agent

# Stage 2: Runtime
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    borgbackup \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=rust-builder /app/target/release/agent /app/agent

ENTRYPOINT ["/app/agent"]
