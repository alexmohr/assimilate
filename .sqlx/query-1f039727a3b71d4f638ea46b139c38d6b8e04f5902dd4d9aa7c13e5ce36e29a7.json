  "query": "SELECT d.id, d.name, d.address, d.port, d.description, d.repo_host_id, d.wake_enabled, d.wake_mac_address, d.wake_broadcast_address, d.wake_timeout_seconds, d.intermittent, d.catch_up_recheck_minutes, d.catch_up_give_up_minutes, d.last_checked_at, d.last_check_reachable, (SELECT COUNT(DISTINCT u.schedule_id) FROM (SELECT sd.schedule_id FROM schedule_dependencies sd WHERE sd.dependency_host_id = d.id UNION SELECT st.schedule_id FROM agent_default_dependencies ad JOIN schedule_targets st ON st.agent_id = ad.agent_id WHERE ad.dependency_host_id = d.id) u) AS \"schedule_count!\", (SELECT COUNT(*) FROM agent_default_dependencies ad WHERE ad.dependency_host_id = d.id) AS \"agent_default_count!\", (SELECT COUNT(*) FROM dependency_catch_ups c WHERE c.dependency_host_id = d.id) AS \"waiting_count!\" FROM dependency_hosts d ORDER BY d.name",
