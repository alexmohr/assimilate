  "query": "\n        SELECT h.channel_id, h.name, c.name AS channel, h.value_encrypted AS \"secret!\"\n        FROM notification_channel_headers h\n        JOIN notification_channels c ON c.id = h.channel_id\n        WHERE h.value_encrypted IS NOT NULL\n        FOR UPDATE OF h\n        ",
