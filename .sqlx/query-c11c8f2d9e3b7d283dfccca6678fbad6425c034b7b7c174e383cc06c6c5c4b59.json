  "query": "SELECT DISTINCT h.ssh_host_key AS \"ssh_host_key!\", r.ssh_user FROM repos r JOIN repo_hosts h ON h.id = r.repo_host_id JOIN schedule_repos sr ON sr.repo_id = r.id JOIN schedule_targets st ON st.schedule_id = sr.schedule_id WHERE st.agent_id = $1 AND h.ssh_host_key IS NOT NULL ORDER BY 1, 2",
