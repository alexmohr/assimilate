{
  "db_name": "PostgreSQL",
  "query": "SELECT r.id, r.name, r.repo_path, r.ssh_user, h.ssh_host, h.ssh_port, r.compression AS \"compression: Compression\", r.encryption AS \"encryption: BorgEncryption\", r.enabled, r.owner_id, r.visibility AS \"visibility: Visibility\", r.sync_schedule, rs.last_synced_at FROM repos r JOIN repo_hosts h ON h.id = r.repo_host_id LEFT JOIN repo_stats rs ON rs.repo_id = r.id ORDER BY r.name",
