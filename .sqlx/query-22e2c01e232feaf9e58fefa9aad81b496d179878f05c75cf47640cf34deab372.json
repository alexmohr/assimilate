{
  "db_name": "PostgreSQL",
  "query": "WITH latest_archives AS (SELECT DISTINCT ON (br.archive_name) br.archive_name, br.started_at, br.original_size, br.deduplicated_size, br.matched, c.hostname AS agent_hostname, c.domain AS agent_domain, br.schedule_id FROM backup_reports br JOIN agents c ON c.id = br.agent_id WHERE br.repo_id = $1 AND br.archive_name IS NOT NULL AND br.status IN ('success', 'warning') ORDER BY br.archive_name, br.started_at DESC, br.id DESC) SELECT archive_name, started_at, original_size, deduplicated_size, matched, agent_hostname, agent_domain, schedule_id FROM latest_archives ORDER BY started_at DESC",
