{
  "db_name": "PostgreSQL",
  "query": "SELECT DISTINCT r.id, r.name, r.repo_path, r.ssh_user, h.ssh_host, h.ssh_port, h.ssh_host_key, r.passphrase_encrypted, r.compression AS \"compression: Compression\", r.encryption AS \"encryption: BorgEncryption\", r.enabled, r.relocation_pending, r.sync_schedule FROM repos r JOIN repo_hosts h ON h.id = r.repo_host_id JOIN schedule_repos sr ON sr.repo_id = r.id JOIN schedule_targets st ON st.schedule_id = sr.schedule_id WHERE st.agent_id = $1 ORDER BY r.id",
