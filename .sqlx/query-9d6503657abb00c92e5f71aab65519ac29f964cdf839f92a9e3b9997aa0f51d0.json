{
  "db_name": "PostgreSQL",
  "query": "SELECT s.id AS schedule_id, s.name AS schedule_name, sr.repo_id, st.agent_id, a.hostname, s.schedule_type AS \"schedule_type: ScheduleType\", s.cron_expression, s.on_failure AS \"on_failure: OnFailure\", st.execution_order, sr.required, s.missed_backup_threshold, am.intermittent AS agent_intermittent, s.wake_override AS \"wake_override: ScheduleWakeOverride\", s.next_run_at AS \"due_at!\" FROM schedules s JOIN schedule_repos sr ON sr.schedule_id = s.id JOIN repos r ON r.id = sr.repo_id JOIN schedule_targets st ON st.schedule_id = s.id JOIN agents a ON a.id = st.agent_id JOIN machines am ON am.id = a.machine_id WHERE s.enabled = true AND r.enabled = true AND a.is_hidden = false AND s.next_run_at IS NOT NULL AND s.next_run_at <= $1 ORDER BY s.id, st.execution_order, sr.execution_order",
