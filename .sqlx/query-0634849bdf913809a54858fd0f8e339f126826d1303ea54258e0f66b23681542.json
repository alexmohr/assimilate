  "query": "INSERT INTO agent_vms (agent_id, name, included, limit_bytes) VALUES ($1, $2, $3, $4) ON CONFLICT (agent_id, name) DO UPDATE SET included = COALESCE($3, agent_vms.included), limit_bytes = EXCLUDED.limit_bytes RETURNING id, name, included, limit_bytes, state, mode, disk_count, disk_bytes, staged_bytes, chain_length, last_error, last_scanned_at, last_staged_at",
