#
# borg-backup -- common exclude patterns
# Shared across all machines. Machine-specific excludes go in excludes.local.
#
# Pattern reference (borg default style, fnmatch, anchored at the path start):
#   Borg stores paths without the leading slash (home/alex/.cache), and "*"
#   also matches "/".
#   /var/cache      the absolute path /var/cache
#   */.cache        a ".cache" component under any directory, i.e. for all users
#   *.pyc           any path ending in .pyc
#   A bare ".cache" only matches a top-level ".cache" - always prefix with "*/".
#
# Drop a ".nobackup" file into any directory to exclude it on the fly.

# ===========================================================
# Containers, VMs, app stores
# ===========================================================
*/.docker/machine
*/.local/share/containers
*/.local/share/flatpak
*/.local/share/Steam
*/.steam
/snap
/var/lib/containerd
/var/lib/containers
/var/lib/docker
/var/lib/flatpak
/var/lib/kubelet
/var/lib/lxc
/var/lib/lxd
/var/lib/rancher
/var/lib/snapd

# ===========================================================
# IDEs & editors - extensions, plugins (re-downloadable)
# ===========================================================
*/.emacs.d/elpa
*/.emacs.d/straight
*/.local/share/JetBrains
*/.local/share/nvim/lazy
*/.local/share/nvim/mason
*/.local/share/nvim/site/pack
*/.vim/bundle
*/.vim/plugged
*/.vscode*

# ===========================================================
# Browsers - caches & session storage
# ===========================================================
*/.config/chromium/*/Cache
*/.config/chromium/*/Code Cache
*/.config/google-chrome/*/Cache
*/.config/google-chrome/*/Code Cache
*/.config/google-chrome/*/Service Worker/CacheStorage
*/.mozilla/firefox/*/cache2
*/.mozilla/firefox/*/thumbnails

# ===========================================================
# OS: temporary, runtime, virtual filesystems
# ===========================================================
*/lost+found
/dev
/lost+found
/proc
/run
/sys
/tmp
/var/lock
/var/run
/var/spool
/var/tmp

# ===========================================================
# OS: logs, caches, crash dumps, swap
# ===========================================================
*.log
/swap.img
/swapfile
/var/cache
/var/log
/var/lib/systemd/coredump

# ===========================================================
# Package managers - system
# ===========================================================
/var/lib/apt/lists
/var/lib/pacman/sync

# ===========================================================
# Package managers - language / userland
# ===========================================================
# .NET / conda / misc
*/.conda/pkgs
*/.nuget/packages

# Go
*/go/pkg/mod/cache

# Homebrew
*/.homebrew/cache

# Java / JVM
*/.gradle/caches
*/.gradle/daemon
*/.gradle/native
*/.gradle/wrapper
*/.m2/repository

# Node.js
*/.bower_cache
*/.bun/install
*/.local/share/pnpm
*/.npm
*/.pnpm-store
*/.yarn/cache
*/node_modules

# Python
*.pyc
*.pyo
*/.local/share/uv
*/.local/share/virtualenv
*/.mypy_cache
*/.pyenv/versions
*/.pytest_cache
*/.ruff_cache
*/.tox
*/.venv
*/.virtualenvs
*/__pycache__

# Ruby
*/.bundle/cache
*/.gem
*/.rbenv/versions

# Rust
*/.cargo/git
*/.cargo/registry
*/target/debug
*/target/release
*rustup*

# Version managers
*/.asdf/installs
*/.local/share/mise
*/.sdkman/archives

# ===========================================================
# User: downloads, caches, trash, thumbnails
# ===========================================================
*/.cache
*/.local/share/Trash
*/.thumbnails
*/.Trash
*/.Trash-*
*/Downloads

# ===========================================================
# Miscellaneous re-downloadable / generated data
# ===========================================================
*.gguf
*.iso
*/.android/cache
*/.electron
*/.nvm/.cache

# ===========================================================
# Build artifacts & junk
# ===========================================================
# No core-dump patterns: */core would exclude directories named core, and
# */core.* would exclude source files such as core.py or core.rs.
# systemd-coredump is covered by /var/lib/systemd/coredump above.
*.swo
*.swp

# ===========================================================
# BSD-specific (ignored harmlessly on Linux)
# ===========================================================
/usr/obj
/usr/ports/distfiles
/var/db/portsnap

# ===========================================================
# Catch-all: anything with "cache" in the name
# ===========================================================
*cache*
