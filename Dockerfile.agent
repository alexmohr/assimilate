# Stage 1: Build Rust agent binary
FROM rust:trixie AS rust-builder
ARG AGENT_VERSION
ENV APP_VERSION_OVERRIDE=$AGENT_VERSION
WORKDIR /app
# Pinned to a known-good date rather than the floating "nightly" channel - see
# .github/actions/setup-rust-nightly-db/action.yml for why.
RUN rustup default nightly-2026-08-21

COPY Cargo.toml Cargo.lock ./
COPY crates/ crates/
RUN cargo build --release -p agent

# Stage 2: Runtime
FROM debian:trixie-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libssl3 \
    borgbackup \
    openssh-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=rust-builder /app/target/release/agent /app/agent

ENTRYPOINT ["/app/agent"]
