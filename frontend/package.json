{
  "name": "@assimilate/frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Vue.js 3 web UI for Assimilate backup management",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:preview": "PLAYWRIGHT_WEB_SERVER=preview E2E_BASE_URL=http://localhost:4173 playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "e2e:coverage": "nyc report --reporter=lcov --report-dir=coverage-e2e --temp-dir=.nyc_output",
    "screenshots": "playwright test --config playwright.screenshots.config.ts && python3 ../scripts/screenshot_fingerprint.py --update"
  },
  "dependencies": {
    "@lucide/vue": "^1.82.0",
    "@primeuix/themes": "^3.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "axios": "^1.21.1",
    "chart.js": "^4.6.2",
    "pinia": "^4.1.0",
    "postcss": "^8.5.34",
    "primevue": "^5.0.6",
    "tailwindcss": "^4.3.5",
    "v-calendar": "^3.1.2",
    "vue": "^3.5.46",
    "vue-chartjs": "^5.3.7",
    "vue-router": "^5.5.3"
  },
  "overrides": {
    "glob": "^14.0.6",
    "test-exclude": {
      "minimatch": "^11.0.9"
    },
    "editorconfig": {
      "minimatch": "^11.0.9"
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.11",
    "@typescript-eslint/utils": "^8.74.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^5.1.2",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.16.0",
    "eslint-config-prettier": "^10.1.9",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "nyc": "^18.0.0",
    "prettier": "^3.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.4.0",
    "vite-plugin-istanbul": "^9.0.1",
    "vitest": "^5.1.2",
    "vue-tsc": "^3.3.14"
  }
}
