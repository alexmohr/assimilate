  "query": "SELECT r.id, r.name, r.repo_path, r.ssh_user, h.ssh_host, h.ssh_port, r.compression AS \"compression: Compression\", r.encryption AS \"encryption: BorgEncryption\", r.enabled, r.owner_id, r.visibility AS \"visibility: Visibility\", r.sync_schedule, r.repo_host_id, hm.wake_enabled, hm.wake_mac_address, hm.wake_broadcast_address, hm.wake_timeout_seconds, hm.shutdown_after_backup, h.machine_id FROM repos r JOIN repo_hosts h ON h.id = r.repo_host_id JOIN machines hm ON hm.id = h.machine_id WHERE r.id = $1",
